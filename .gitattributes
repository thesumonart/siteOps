# Normalize every text file to LF in the repository and in the working tree.
# Without this, Windows checkouts get CRLF and `prettier --check` (endOfLine: lf)
# fails in Linux CI.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary

pnpm-lock.yaml -diff linguist-generated=true
