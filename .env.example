# ---------------------------------------------------------------------------
# SiteOps environment configuration
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# Every variable below is validated at startup; a missing or malformed required
# value stops the process rather than letting it run misconfigured.
# ---------------------------------------------------------------------------

# --- Shared ----------------------------------------------------------------
NODE_ENV=development

# Public origin of the Next.js app. Used for CORS, cookies and email links.
APP_URL=http://localhost:3000
# Public origin of the NestJS API.
API_URL=http://localhost:4000

# --- Database --------------------------------------------------------------
# Local development uses the Docker Compose service (`pnpm docker:up`), which
# runs a single-node replica set. Production uses a MongoDB Atlas connection
# string. SiteOps uses no transactions — its guarantees are unique indexes — so
# a standalone works too, which is what CI runs against.
MONGODB_URI=mongodb://localhost:27017/siteops?replicaSet=rs0&directConnection=true
MONGODB_MAX_POOL_SIZE=10
# Runs the index sync at startup. Convenient locally, wrong in production: an
# index build issued by a starting process can stall a live cluster, so deploy
# with this false and run `pnpm --filter @siteops/database indexes:sync` as an
# explicit step. Without one or the other the database enforces none of the
# uniqueness the product relies on.
MONGODB_AUTO_INDEX=true

# --- Authentication --------------------------------------------------------
# Minimum 32 characters. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-at-least-32-random-characters
# Only needed when the API and web app are on different hosts.
# COOKIE_DOMAIN=.siteops.app

# --- Email -----------------------------------------------------------------
# Required in production. Without it, verification and alert emails are logged
# instead of sent, which is fine locally and unacceptable in production.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=SiteOps <onboarding@resend.dev>

# --- API -------------------------------------------------------------------
PORT=4000
LOG_LEVEL=debug
# Extra browser origins allowed to send credentialed requests, comma-separated.
# ADDITIONAL_TRUSTED_ORIGINS=https://staging.siteops.app
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX_REQUESTS=10
# Enable only when running behind a proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# --- Web (Next.js) ---------------------------------------------------------
# Browser-visible. Never put a secret in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Monitoring worker -----------------------------------------------------
WORKER_PORT=4001
# How often the scheduler looks for websites that are due for a check.
MONITOR_POLL_INTERVAL_SECONDS=15
# Websites checked simultaneously. Raise only with the outbound bandwidth to match.
MONITOR_CONCURRENCY=10
MONITOR_REQUEST_TIMEOUT_MS=10000
MONITOR_MAX_REDIRECTS=5
# Consecutive failures before an outage is confirmed, and successes before it is
# considered resolved. Both exist to absorb transient network noise.
MONITOR_FAILURE_THRESHOLD=3
MONITOR_RECOVERY_THRESHOLD=2
MONITOR_MAX_ATTEMPTS=2
# Set true ONLY in automated tests, which need to reach a local mock server.
MONITOR_ALLOW_PRIVATE_ADDRESSES=false
