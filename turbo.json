{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env", "packages/config/tsconfig/*.json"],
  "globalEnv": ["NODE_ENV", "CI", "MONGODB_URI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_DIST_DIR", "NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_APP_URL"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "env": ["E2E_WEB_PORT", "E2E_API_PORT", "E2E_API_URL", "E2E_MONGODB_URI", "NEXT_DIST_DIR"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
