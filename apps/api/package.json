{
  "name": "@siteops/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "concurrently -k -n tsc,node -c blue,green \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "clean": "rimraf dist .turbo",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@siteops/database": "workspace:*",
    "@siteops/shared": "workspace:*",
    "better-auth": "catalog:",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "mongoose": "catalog:",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "resend": "6.25.0",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.1",
    "@siteops/config": "workspace:*",
    "@swc/core": "1.16.1",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.5",
    "eslint": "catalog:",
    "pino-pretty": "13.1.3",
    "rimraf": "catalog:",
    "supertest": "7.2.2",
    "typescript": "catalog:",
    "unplugin-swc": "1.5.11",
    "vitest": "catalog:"
  }
}
