{
  "name": "@siteops/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "concurrently -k -n tsc,node -c blue,green \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --enable-source-maps --env-file-if-exists=../../.env dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "clean": "rimraf dist .turbo",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@siteops/database": "workspace:*",
    "@siteops/shared": "workspace:*",
    "mongoose": "catalog:",
    "pino": "10.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@siteops/config": "workspace:*",
    "@types/node": "catalog:",
    "concurrently": "10.0.5",
    "eslint": "catalog:",
    "pino-pretty": "13.1.3",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
